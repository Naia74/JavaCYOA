package database;

import java.sql.*;

//Handles all database operations for the game
public class DatabaseManager{
    private static final String URL = "jdbc:derby:GameDB;create=true";

    //Creates the PLAYER_STATS table if it does not already exist.
    public void createTable(){
        try(Connection conn = DriverManager.getConnection(URL);
             Statement stmt = conn.createStatement()){
            String sql = "CREATE TABLE PLAYER_STATS (" +
                         "ID INT PRIMARY KEY, " +
                         "NAME VARCHAR(50), " +
                         "HEALTH INT, " +
                         "LEVEL INT)";
            stmt.executeUpdate(sql);

        }catch (Exception e){
            System.out.println("Table creation skipped: " + e.getMessage());
        }
    }

    //Inserts a player record into the database
    public void insertPlayer(int id, String name, int health, int level){
        String sql = "INSERT INTO PLAYER_STATS (ID, NAME, HEALTH, LEVEL) VALUES (?, ?, ?, ?)";

        try(Connection conn = DriverManager.getConnection(URL);
             PreparedStatement ps = conn.prepareStatement(sql)){
            ps.setInt(1, id);
            ps.setString(2, name);
            ps.setInt(3, health);
            ps.setInt(4, level);
            ps.executeUpdate();

        }catch (Exception e){
            System.out.println("Insert failed: " + e.getMessage());
        }
    }

    //Retrieves the player's health from the database
    public int getPlayerHealth(int id){
        String sql = "SELECT HEALTH FROM PLAYER_STATS WHERE ID = ?";

        try(Connection conn = DriverManager.getConnection(URL);
             PreparedStatement ps = conn.prepareStatement(sql)){
            ps.setInt(1, id);
            ResultSet rs = ps.executeQuery();

            if(rs.next()){
                return rs.getInt("HEALTH");
            }

        }catch (Exception e){
            System.out.println("Read failed: " + e.getMessage());
        }
        return -1;
    }
}
